  "instructions_to_main_agent": "Ensure all interactive elements have data-testid attributes, use Lucide React icons, Sonner for toast notifications, and ensure smooth responsive design across mobile and desktop. Implement mock POST /api/leads endpoint properly with form state retention and success celebration.",
  "universal_guidelines": [
    "Never use universal transition all",
    "Every interactive element must have hover and focus states with high contrast",
    "Ensure generous spacing (p-8, p-12)",
    "Use data-testid on all buttons, inputs, links, and forms"
  ]
