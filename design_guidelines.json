    "visual_enhancers": {
      "shadows": [
        "shadow-[0_10px_30px_rgba(10,25,47,0.08)]",
        "shadow-lg"
      ],
      "glassmorphism": "backdrop-blur-xl bg-white/80 border border-white/40 shadow-sm",
      "radii": "rounded-2xl"
    }
  },
  "layouts": {
    "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
