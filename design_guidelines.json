{
  "project_name": "Orbitus Global Overseas",
  "app_type": "hybrid_fullstack",
  "design_system": {
    "typography": {
      "headings": "Plus Jakarta Sans, sans-serif",
      "body": "Inter, sans-serif",
      "hierarchy": {
        "h1": "text-4xl sm:text-5xl lg:text-6xl tracking-tight font-extrabold",
        "h2": "text-2xl sm:text-3xl lg:text-4xl tracking-tight font-bold",
        "h3": "text-xl sm:text-2xl font-semibold",
        "h4": "text-lg sm:text-xl font-semibold",
        "body": "text-base text-slate-600 leading-relaxed",
        "small": "text-sm text-slate-500"
      }
    },
    "colors": {
      "primary": "#0A192F",
      "primary_light": "#1E3A8A",
      "accent": "#D97706",
      "accent_hover": "#B45309",
      "amber_highlight": "#F59E0B",
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "slate_gray": "#475569",
      "border": "#E2E8F0"
